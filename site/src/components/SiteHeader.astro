---
import { REPO, image } from '@/data/site';

const links = [
  { href: '#window', label: 'The app' },
  { href: '#features', label: 'Features' },
  { href: '#states', label: 'Icon states' },
  { href: '#install', label: 'Install' },
  { href: '#faq', label: 'FAQ' },
  { href: REPO, label: 'GitHub' },
];
---

<header class="site-header">
  <div class="shell">
    <a class="brand" href="/">
      <img src={image('logo.png')} width="28" height="28" alt="" />
      Globlin
    </a>
    <nav class="site-nav">
      {links.map((link) => <a href={link.href}>{link.label}</a>)}
    </nav>
  </div>
</header>
