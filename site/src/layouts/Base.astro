---
import '@/styles/site.css';
import { faq, plainText } from '@/data/faq';
import { DESCRIPTION, LATEST_RELEASE, REPO, SITE_URL, SOCIAL_DESCRIPTION, TITLE, image } from '@/data/site';

const ogImage = new URL(image('og.png'), SITE_URL).href;

const application = {
  '@context': 'https://schema.org',
  '@type': 'SoftwareApplication',
  name: 'Globlin',
  description:
    'A tray application for Windows, macOS and Linux, in beta, that watches globally installed packages across npm, bun, pnpm, yarn, pipx, uv, cargo, go, dotnet, gem, Homebrew, scoop, winget, choco and the PowerShell Gallery, plus global agent skills installed with skills.sh, reports which ones are outdated, and updates them on a click.',
  url: SITE_URL,
  downloadUrl: LATEST_RELEASE,
  applicationCategory: 'DeveloperApplication',
  operatingSystem: 'Windows 10, Windows 11, macOS 11 or later, Linux',
  license: 'https://www.gnu.org/licenses/gpl-3.0.html',
  isAccessibleForFree: true,
  offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
  author: { '@type': 'Person', name: 'TOR968', url: 'https://github.com/TOR968' },
  sameAs: REPO,
};

const questions = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faq.map((entry) => ({
    '@type': 'Question',
    name: entry.question,
    acceptedAnswer: { '@type': 'Answer', text: plainText(entry.answer) },
  })),
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="dark" />

    <title>{TITLE}</title>
    <meta name="description" content={DESCRIPTION} />
    <link rel="canonical" href={SITE_URL} />
    <link rel="icon" href={image('logo.png')} type="image/png" />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Globlin" />
    <meta property="og:url" content={SITE_URL} />
    <meta property="og:title" content={TITLE} />
    <meta property="og:description" content={SOCIAL_DESCRIPTION} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="The Globlin logo above the tray icon in its four states" />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={TITLE} />
    <meta name="twitter:description" content={SOCIAL_DESCRIPTION} />
    <meta name="twitter:image" content={ogImage} />

    <script is:inline type="application/ld+json" set:html={JSON.stringify(application)} />
    <script is:inline type="application/ld+json" set:html={JSON.stringify(questions)} />
  </head>
  <body>
    <slot />
  </body>
</html>
